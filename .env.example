# ==========================================
# Gentileschi Studio — Variabili d'Ambiente
# ==========================================

# 1. Supabase (Database, Auth, Storage)
# Recupera questi valori da: Supabase Dashboard -> Project Settings -> API Keys
# Il nome ANON_KEY è mantenuto per compatibilità; usa la chiave Publishable attuale.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your-public-key

# 2. Google Gemini API (AI Assistant & Caption Generator)
# Recupera la chiave da: https://aistudio.google.com/app/apikey
# In produzione su Vercel, imposta GEMINI_API_KEY tra le Environment Variables del progetto.
GEMINI_API_KEY=your-gemini-api-key
# Chiave Secret del progetto scelto per l'app, esclusivamente sul server.
# Il nome dedicato evita conflitti con variabili gestite da integrazioni Vercel.
SUPABASE_SERVER_KEY=sb_secret_your-server-only-key
AI_USER_DAILY_LIMIT=20
AI_GLOBAL_DAILY_LIMIT=500
